#!/bin/sh
#
# Check the "Other Application Playing Audio" rule's detector against real sounds.
#
#   Tools/audiocheck        # ~45 s; plays Ping, a beep, speech, and a clip through AVPlayer
#
# Compiles Services/OtherAppAudioMonitor.swift with its own main.swift and logs each
# transition it reports. Exits non-zero unless exactly the expected transitions happened.
# Makes sound: run it with the volume up if you want to hear what it is measuring.
#
set -e

case "$1" in -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;; esac

root=$(cd "$(dirname "$0")/.." && pwd)
dir="$root/Tools/audio-check"
src="$root/Open Wallpaper Engine"
out="${TMPDIR:-/tmp}/audiocheck"

newest=$(find "$dir/main.swift" "$src/Services/OtherAppAudioMonitor.swift" -newer "$out" 2>/dev/null | head -1 || true)
if [ ! -x "$out" ] || [ -n "$newest" ]; then
    echo "building audiocheck" >&2
    swiftc -O -o "$out" "$dir/main.swift" "$src/Services/OtherAppAudioMonitor.swift"
fi

exec "$out" "$@"

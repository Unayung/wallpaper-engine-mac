    "×8 MSAA is only recommended for powerful high-end desktop graphics cards.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议仅将 x8 MSAA 用于功能强大的高端台式机显卡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "×8 MSAA 僅建議用於高階桌上型顯示卡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "×8 MSAAはハイエンドデスクトップグラフィックカードにのみ推奨されます。"
          }
        }
      }
    },

    "Animate GIF previews in library" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在资源库中播放 GIF 预览"
          }
        }
      }
    },
    "Follows the system language. To use a different language for this app, add it under Applications in Language & Region." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "资源库文件夹"
          }
        }
      }
    },
    "The chosen folder %@ is not available, so the default folder is used until it is." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选文件夹 %@ 当前不可用，在其恢复可用之前将使用默认文件夹。"
          }
        }
      }
    },
    "Changing the folder does not move or delete any files. A screen showing a wallpaper from the previous folder keeps it until you choose another, and new Workshop downloads go to the current folder." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改文件夹不会移动或删除任何文件。正在显示旧文件夹中壁纸的屏幕会继续显示它，直到你选择其他壁纸；新的创意工坊下载会存入当前文件夹。"
          }
        }
      }
    },
    "Disable scene scripts" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用场景脚本"
          }
        }
      }
    },
    "The chosen folder %@ does not exist, so the default location is used." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选文件夹 %@ 不存在，因此使用默认位置。"
          }
        }
      }
    },
    "Not found. Scene layers that use Wallpaper Engine's shared models, materials and particle presets will be missing. Install Wallpaper Engine with Steam, or choose its assets folder." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未找到。使用 Wallpaper Engine 共享模型、材质和粒子预设的场景图层将无法显示。请通过 Steam 安装 Wallpaper Engine，或选择其 assets 文件夹。"

          }
        }
      }
    },
    "You can easily import video type wallpapers from steam workshop of Wallpaper Engine and modify some properties as well, like playback rate, volume, etc.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以轻松的从 Wallpaper Engine 的创意工坊中导入视频类型的壁纸，同时设定一些属性，例如播放速率，音量等。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以輕鬆從 Steam 工作坊匯入 Wallpaper Engine 的影片桌布，並修改播放速率、音量等屬性。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam WorkshopのWallpaper Engineからビデオ壁紙を簡単にインポートし、再生速度や音量などのプロパティを変更できます。"
          }
        }
      }
    },
    "You may feel familar when using this dynamic desktop wallpaper tool since it almost has the same layout to its ancesstor.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在使用时也许会感到非常熟悉，因为它和它的原型的 UI 布局几乎完全一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用這款動態桌面桌布工具時，您可能會感到熟悉，因為它的版面配置幾乎與其原版相同。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このダイナミックデスクトップ壁紙ツールを使用すると、祖先とほぼ同じレイアウトで親しみやすいかもしれません。"
          }
        }
      }
    },

<dict>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Open Wallpaper Engine stores your wallpaper packages in a folder inside Documents.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Open Wallpaper Engine reads wallpapers you download from the Steam Workshop.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>haren724.top</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
